<idea-plugin>
    <id>com.gorowynn.piwebui</id>
    <name>pi-webui</name>
    <vendor url="https://github.com/gorowynn/pi-webui">gorowynn</vendor>
    <description>Embeds the pi-webui panel in a tool window via JCEF.
        Requires pi-webui running (e.g. `node server.js` or pi `/webui`).</description>

    <!-- Platform module = available in all JetBrains IDEs -->
    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="pi-webui"
                    anchor="right"
                    factoryClass="com.gorowynn.piwebui.PiWebuiToolWindowFactory"/>
        <applicationService serviceImplementation="com.gorowynn.piwebui.PiWebuiSettings"/>
        <!-- Shows pi edit/write changes as a diff in a CENTER editor tab (in the
             main IDE window), with the 4 Approve/Deny buttons. -->
        <fileEditorProvider implementation="com.gorowynn.piwebui.DiffReviewEditorProvider"/>
    </extensions>
</idea-plugin>
