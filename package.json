{
  "name": "pi-webui",
  "version": "0.2.0",
  "description": "Minimal-dependency web UI for pi. Launch directly (`pi-webui`) or via pi (`/webui`).",
  "keywords": ["pi-package"],
  "license": "MIT",
  "files": [
    "server.js",
    "bin.js",
    "broker.js",
    "advisor-contract.js",
    "web-url-policy.js",
    "web-fetch.js",
    "web-search.js",
    "github-interceptor.js",
    "git.js",
    "isolated-prompt.js",
    "pi-sdk-runtime.js",
    "jsonl.js",
    "livebuf.js",
    "recent-sessions.js",
    "session-entries.js",
    "secondary-runs.js",
    "sse-queue.js",
    "subagents.js",
    "workspace-file.js",
    "workspaces.js",
    "public",
    "extensions",
    "skills"
  ],
  "scripts": {
    "start": "node server.js",
    "test": "node test/run-all.js"
  },
  "bin": {
    "pi-webui": "bin.js"
  },
  "pi": {
    "extensions": ["./extensions"],
    "skills": ["./skills"]
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.4"
  }
}
